# ==============================================================================
# Project AI v3 - Environment Variables Configuration Template
# ==============================================================================
# Hướng dẫn:
# 1. Copy file này thành `.env`:
#      cp .env.example .env
# 2. Điền các giá trị thực tế bên dưới.
# 3. Không bao giờ commit file `.env` chứa token/key thật vào git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hugging Face Credentials (Source of truth cho Dataset & Model Artifacts)
# ------------------------------------------------------------------------------
# HF Write Token lấy tại: https://huggingface.co/settings/tokens (cần quyền Write)
HF_TOKEN=hf_your_write_token_here

# Tên repo Dataset trên Hugging Face (ví dụ: username/vsl400-front-view)
HF_DATASET_REPO=your_username/vsl400-front-view

# Chế độ bảo mật của repo Dataset (true = Private, false = Public)
HF_DATASET_PRIVATE=true

# ------------------------------------------------------------------------------
# 2. Weights & Biases Credentials (Tracking & Metrics)
# ------------------------------------------------------------------------------
# W&B API Key lấy tại: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=vsl400-v3
WANDB_ENTITY=your_wandb_username_or_team

# ------------------------------------------------------------------------------
# 3. Google Drive / rclone (Landing zone & Cold backup)
# ------------------------------------------------------------------------------
# Remote path trên Google Drive
GDRIVE_SOURCE_PATH=gdrive:project_ai/datasets/vsl400_front_view/

# Đường dẫn file rclone config trên máy local
RCLONE_CONFIG_PATH=~/.config/rclone/rclone.conf
